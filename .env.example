# Copy to backend/.env and fill in. Never commit the real file.
APP_ENV=production                 # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com   # comma separated; defaults to FRONTEND_URL in production
ENABLE_API_DOCS=false
TRUST_PROXY_HEADERS=true               # only behind your own nginx/proxy

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=institute_management
MYSQL_USER=
MYSQL_PASSWORD=
# or a full URL: DATABASE_URL=mysql+pymysql://user:pass@host/db

# Email (fee receipts, password reset, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FEE_RECEIPT_EMAIL_MODE=dry_run         # change to live when ready to email real students

# Optional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AUTOMATION_ENABLED=false
AUTOMATION_DRY_RUN=true
ADMISSION_PAYMENT_PROVIDER=manual
